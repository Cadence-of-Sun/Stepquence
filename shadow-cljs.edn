{:nrepl {:port 8777}

 

 :source-paths ["src" "dev" "test"]

 :dependencies
 [[reagent "1.2.0"]
  [re-frame "1.4.7"]
  [metosin/malli "0.16.4"]
  [day8.re-frame/tracing "0.9.2"]

  [binaryage/devtools "1.0.7"]
  [day8.re-frame/re-frame-10x "1.12.0"]]

 :dev-http
 {8282 "resources/public"
  8290 "target/browser-test"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js/compiled"
   :asset-path "/js/compiled"
   :modules
   {:app {:init-fn stepquence.core/init}}
   :devtools
   {:preloads [day8.re-frame-10x.preload]}
   :dev
   {:compiler-options
    {:closure-defines
     { re-frame.trace.trace-enabled? true
      day8.re-frame.tracing.trace-enabled? true}}}
   :release
   {:build-options
    {:ns-aliases
     {day8.re-frame.tracing day8.re-frame.tracing-stubs}}}}

  ;; The published build (scripts/publish.sh): separate from :app so
  ;; publishing never disturbs a running watch; relative asset path so it
  ;; works from any folder of a static site.
  :dist
  {:target     :browser
   :output-dir "dist/js/compiled"
   :asset-path "js/compiled"
   :modules    {:app {:init-fn stepquence.core/init}}
   :release    {:build-options
                {:ns-aliases
                 {day8.re-frame.tracing day8.re-frame.tracing-stubs}}}}

  :test
  {:target    :node-test
   :output-to "target/test/node-tests.js"
   :ns-regexp "-test$"
   :autorun   true}}}
